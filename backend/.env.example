APP_NAME=AgentHQ API
HOST=127.0.0.1
PORT=8000

# Database Configuration (PostgreSQL for Cloud / Render; leave blank to use SQLite)
DATABASE_URL=
AGENTHQ_DB_PATH=backend/data/agenthq.db

# AI Inference Provider ('ollama' for local development, 'cloudflare' for production)
AI_PROVIDER=ollama

# Local Ollama Configuration (Local development only)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Cloudflare Workers AI Configuration (Cloud production only)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/qwen/qwen3.8-27b
CLOUDFLARE_DAILY_NEURON_LIMIT=8500

# Security & Authentication (Phase 2C Production Hardening)
ENVIRONMENT=development
STUDIO_USERNAME=founder
STUDIO_PASSWORD_HASH=
SESSION_SECRET=
RUNTIME_API_TOKEN=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_EXPIRY_SECONDS=86400
WS_TICKET_EXPIRY_SECONDS=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=60
TRUSTED_PROXY=0
